# degself web-v2 — copy to .env.local and fill values.
# Never commit real secrets.

# ── Site ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://degself.com

# Google Sign-In is configured in the Supabase Dashboard
# (Authentication → Providers → Google), not via env vars here.
# OAuth callback: https://degself.com/auth/callback


# ── Supabase ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Prefer publishable/anon for the browser client:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias still accepted:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (service role). Prefer SUPABASE_SECRET_KEY; SERVICE_ROLE_KEY still works.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Product analytics (PostHog EU Cloud) ─────────────
# Public project token only (phc_...). Never put a PostHog personal API key here.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Admin auth ────────────────────────────────────────
# Login bootstrap password (used until a DB hash is set in admin_credentials).
MODERATION_PASSWORD=
# Opaque session HMAC secret (recommended). If unset, MODERATION_PASSWORD is
# used only as HMAC key material — never written into the cookie as plaintext.
ADMIN_SESSION_SECRET=

# ── AI (اسأل دق سلف / translate) ──────────────────────
ANTHROPIC_API_KEY=
# Salt for hashing visitor IPs in the Asaali cost guard (recommended).
# Falls back to ADMIN_SESSION_SECRET / MODERATION_PASSWORD if unset.
IP_HASH_SALT=

# ── WhatsApp Cloud API (optional; gated by WHATSAPP_ENABLED) ──
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_TEMPLATE_OFFERS=
# WHATSAPP_TEMPLATE_LANG=ar

# ── Founder alerts (CallMeBot) ────────────────────────
# CALLMEBOT_PHONE=
# CALLMEBOT_APIKEY=

# ── Cron / Google Search Console indexing ─────────────
CRON_SECRET=
# GSC_SERVICE_ACCOUNT_KEY=   # JSON string of the service account
