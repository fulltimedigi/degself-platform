# degself web-v2 — copy to .env.local and fill values.
# Never commit real secrets.

# ── Site ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://degself.com

# Google Sign-In is configured in the Supabase Dashboard
# (Authentication → Providers → Google), not via env vars here.
# OAuth callback: https://degself.com/auth/callback


# ── Supabase ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Prefer publishable/anon for the browser client:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias still accepted:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (service role). Prefer SUPABASE_SECRET_KEY; SERVICE_ROLE_KEY still works.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Product analytics (PostHog EU Cloud) ─────────────
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# ── Admin auth ────────────────────────────────────────
MODERATION_PASSWORD=
ADMIN_SESSION_SECRET=

# ── AI (اسأل دق سلف / translate) ──────────────────────
ANTHROPIC_API_KEY=
IP_HASH_SALT=

# ── WhatsApp Cloud API (optional; gated by WHATSAPP_ENABLED) ──
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Customer offer-ready template (optional override; existing default offers_ready_ar)
# WHATSAPP_TEMPLATE_OFFERS=offers_ready_ar
# REQUIRED before automatic garage RFQ delivery is enabled. No default is used.
# WHATSAPP_TEMPLATE_GARAGE_RFQ=garage_quote_request_ar
# WHATSAPP_TEMPLATE_LANG=ar

# ── Founder alerts (CallMeBot) ────────────────────────
# CALLMEBOT_PHONE=
# CALLMEBOT_APIKEY=

# ── Cron / Google Search Console indexing ─────────────
CRON_SECRET=
# GSC_SERVICE_ACCOUNT_KEY=   # JSON string of the service account

# Edge geo-block for data-center bot traffic (proxy.ts). Comma-separated ISO
# alpha-2 codes; unset defaults to "CN". Set to empty to disable. Search-engine
# crawlers (Googlebot, Bingbot, …) are always allowed through regardless.
BLOCKED_COUNTRIES=CN
