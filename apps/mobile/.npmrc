# Expo SDK 57 pins react@19.2.3 while an optional react-native-web/react-dom peer
# resolves react-dom@19.2.8 (peer wants react ^19.2.8). This mobile-only app does
# not ship Expo Web, so that peer is irrelevant. legacy-peer-deps keeps `npm ci`
# deterministic in CI without forcing incompatible versions. Revisit when the SDK
# aligns the react/react-dom pins.
legacy-peer-deps=true
