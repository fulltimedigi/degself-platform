# DEGSELF mobile — PUBLIC runtime config (M1).
# Copy to `.env` for local dev, or set these per EAS build profile.
#
# EVERY value here is PUBLIC and shipped in the app bundle. NEVER put a secret in
# an EXPO_PUBLIC_* var: no service-role key, DB URL, Supabase JWT secret,
# Google client SECRET, Anthropic/WABA/admin/Vercel secrets. Those live only on
# the server.

# Supabase project (public URL + PUBLISHABLE/anon key — RLS is the boundary).
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<supabase publishable / anon key>

# DEGSELF web/API base for the native account-deletion Bearer call.
EXPO_PUBLIC_API_BASE_URL=https://degself.com

# Google OAuth WEB client id (public; token audience — also set on the Supabase
# Google provider). The iOS client id (reversed) is a build-time value added to
# the google-signin config plugin as `iosUrlScheme` in app config; never a secret.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<web-oauth-client-id>.apps.googleusercontent.com
